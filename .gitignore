.ruff_cache/

# Artifacts and outputs
# Block large artifacts but allow small result files (JSON, text)
outputs/
checkpoints/
*.ckpt
*.pt
*.pth
*.safetensors
*.bin
**/artifacts/**/*.npz
**/artifacts/**/*.pkl
**/artifacts/**/*.pickle
**/artifacts/**/*.h5
**/artifacts/**/*.hdf5
**/artifacts/**/*.arrow
**/artifacts/**/*.parquet

# Anthony: ignore all new experiment artifacts going forward
# (historical tracked artifacts in 001/009/013/106 remain tracked)
user/anthony/experiments/*/artifacts/

# Logs
*.log
slurm-*.out
slurm-*.err
# SLURM %x-%j.out pattern for experiment jobs (e.g. exp107-coverage-NNNN.out)
exp*-*.out
logs/
**/sbatch/logs/

# NFS temp files
.nfs*

# Data (large files)
/data/
*.wav
*.mp3
*.flac
*.ogg
*.csv
# Package-bundled asset: families.csv ships with the birdclef_107 wheel,
# so it must enter git even though *.csv is otherwise ignored.
!user/anthony/experiments/107-hopfield-prototypes/src/birdclef_107/assets/families.csv
*.parquet
*.arrow
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.pickle

# Model weights
*.onnx
weights/
/models/

# Vendored Kaggle datasets — large binary bundles (ONNX/wheels/etc),
# reproducible via `kaggle datasets download <slug>`. Track only the README.
vendor/kaggle/datasets/*
!vendor/kaggle/datasets/README.md

# Vendored Kaggle notebooks — convention is to track only .ipynb +
# kernel-metadata.json. .py extractions are session-local analysis
# artifacts (regenerable from the .ipynb by walking cells); ignore by
# default. Use `git add -f` if you genuinely want to track one.
vendor/kaggle/notebooks/**/*.py

# Wandb
wandb/

# Environment files (secrets)
.env
.envrc

# OS
.DS_Store
Thumbs.db

# Keep .gitkeep files
!.gitkeep
scratch
